<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.cabinwright.store"
    android:versionCode="3"
    android:versionName="1.2.1">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- downloads, results and status are shared with the root helper through /sdcard/cabinwright/store;
         requests are not: the helper reads them from RequestProvider -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/menu_icon"
        android:allowBackup="false">
        <activity
            android:name=".StoreActivity"
            android:theme="@style/CarTheme"
            android:screenOrientation="landscape"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- shows this app in All Menus (Cabinwright launcher hook) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="dev.cabinwright.category.ALL_MENUS" />
            </intent-filter>
            <meta-data android:name="dev.cabinwright.icon" android:resource="@drawable/menu_icon" />
            <meta-data android:name="dev.cabinwright.icon_disabled" android:resource="@drawable/menu_icon_dis" />
        </activity>
        <!-- the requests the driver confirmed, for the root helper only (see RequestProvider) -->
        <provider
            android:name=".RequestProvider"
            android:authorities="dev.cabinwright.store.requests"
            android:exported="true" />
    </application>
</manifest>
