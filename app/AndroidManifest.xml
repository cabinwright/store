<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.cabinwright.store"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the index and downloads go to /sdcard/cabinwright/store, where the store's service reads them -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/menu_icon"
        android:allowBackup="false">
        <activity
            android:name=".StoreActivity"
            android:theme="@style/CarTheme"
            android:screenOrientation="landscape"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- shows this app in All Menus (Cabinwright launcher hook) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="app.cabinwright.category.ALL_MENUS" />
            </intent-filter>
            <!-- another app's page in the store: extra "package", a NEMESIS id -->
            <intent-filter>
                <action android:name="app.cabinwright.store.action.SHOW_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="app.cabinwright.icon" android:resource="@drawable/menu_icon" />
            <meta-data android:name="app.cabinwright.icon_disabled" android:resource="@drawable/menu_icon_dis" />
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/CarTheme"
            android:screenOrientation="landscape"
            android:exported="false" />
        <!-- the broker's permission prompts: started only by the store's service, as root -->
        <activity
            android:name=".PromptActivity"
            android:theme="@style/CarTheme"
            android:screenOrientation="landscape"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />
    </application>
</manifest>
